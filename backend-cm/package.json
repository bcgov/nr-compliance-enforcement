{
  "name": "backend-cm",
  "author": "BC Government Forestry Suite of Applications Starter Template",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "prisma-pull-complaint-outcome": "prisma db pull --schema=prisma/complaint_outcome/complaint_outcome.prisma",
    "prisma-pull-shared": "prisma db pull --schema=prisma/shared/shared.prisma",
    "prisma-pull-investigation": "prisma db pull --schema=prisma/investigation/investigation.prisma",
    "prisma-pull-inspection": "prisma db pull --schema=prisma/inspection/inspection.prisma",
    "prisma-generate-complaint-outcome": "prisma generate --schema=prisma/complaint_outcome/complaint_outcome.prisma",
    "prisma-generate-shared": "prisma generate --schema=prisma/shared/shared.prisma",
    "prisma-generate-investigation": "prisma generate --schema=prisma/investigation/investigation.prisma",
    "prisma-generate-inspection": "prisma generate --schema=prisma/inspection/inspection.prisma",
    "prisma-all": "npm run prisma-pull-all && npm run prisma-generate-all",
    "prisma-pull-all": "npm run prisma-pull-complaint-outcome && npm run prisma-pull-shared && npm run prisma-pull-investigation && npm run prisma-pull-inspection",
    "prisma-generate-all": "npm run prisma-generate-complaint-outcome && npm run prisma-generate-shared && npm run prisma-generate-investigation && npm run prisma-generate-inspection",
    "build": "nest build && copyfiles -u 1 \"src/**/*.graphql\" dist",
    "build:cli": "nest build --entryFile=./src/cli.js && copyfiles -u 1 \"src/**/*.graphql\" dist/cli",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:staged": "./node_modules/.bin/lint-staged",
    "make-badges": "istanbul-badges-readme --logo=jest --exitCode=1",
    "make-badges:ci": "npm run make-badges -- --ci",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --detectOpenHandles --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "import:all": "nest start --entryFile=./src/cli.js -- import -j parks,bclaws,federallaws",
    "import:parks": "nest start --entryFile=./src/cli.js -- import -j parks",
    "import:bclaws": "nest start --entryFile=./src/cli.js -- import -j bclaws",
    "import:federallaws": "nest start --entryFile=./src/cli.js -- import -j federallaws"
  },
  "dependencies": {
    "@apollo/server": "5.5.0",
    "@as-integrations/express5": "1.1.2",
    "@automapper/core": "9.0.2",
    "@automapper/nestjs": "9.0.2",
    "@automapper/pojos": "9.0.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/testing": "11.2.7",
    "@prisma/client": "6.6.0",
    "axios": "1.20.0",
    "class-validator": "0.14.3",
    "copyfiles": "2.4.1",
    "dotenv": "16.6.1",
    "fast-xml-parser": "5.7.3",
    "geojson": "0.5.0",
    "graphql": "16.13.2",
    "graphql-type-json": "0.3.2",
    "graphql-ws": "5.16.2",
    "helmet": "7.2.0",
    "https-proxy-agent": "7.0.6",
    "jwks-rsa": "3.1.0",
    "nats": "2.29.3",
    "nest-commander": "3.21.0",
    "nest-winston": "1.10.2",
    "nestjs-prisma": "0.27.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.14.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "5.0.10",
    "rxjs": "7.8.2",
    "supercluster": "7.1.5",
    "swagger-ui-express": "5.0.1",
    "winston": "3.17.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@faker-js/faker": "10.6.0",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "20.17.24",
    "@types/supercluster": "7.1.3",
    "@types/supertest": "2.0.16",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-promise": "6.6.0",
    "istanbul-badges-readme": "1.9.0",
    "jest": "30.5.2",
    "jest-badges": "0.1.3",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.5.3",
    "prisma": "6.6.0",
    "prisma-class-generator": "0.2.11",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest",
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@automapper/)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "jest-badges"
    ],
    "testEnvironment": "node",
    "testResultsProcessor": "jest-sonar-reporter"
  },
  "lint-staged": {
    "*.{js,ts}": "./node_modules/.bin/eslint --cache --fix"
  },
  "overrides": {
    "minimist@<1.2.6": "1.2.6",
    "minimatch": {
      ".": "^10.2.3",
      "brace-expansion": "^5.0.12"
    },
    "multer": "^2.1.1",
    "lodash": "^4.17.21",
    "flatted": "^3.4.2",
    "js-yaml": "^4.1.1",
    "jws": "3.2.3",
    "ajv": "^8.17.1",
    "glob": ">=10.5.0",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "copyfiles": {
      "glob": "^7.2.3"
    },
    "@nestjs/graphql": {
      "@graphql-tools/utils": "12.0.4"
    },
    "nestjs-prisma": {
      "@angular-devkit/core": "19.2.27",
      "@angular-devkit/schematics": "19.2.27",
      "@schematics/angular": "19.2.27"
    }
  },
  "version": "3.0.9"
}
