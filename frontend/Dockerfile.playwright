# Playwright overlay image: node_modules + e2e tests on top of the base image frontend/playwright-base/Dockerfile 
# BASE_TAG is set by CI to the PR number that tag always exists because the base job builds it or retags :test
ARG BASE_TAG=test
FROM ghcr.io/bcgov/nr-compliance-enforcement/frontend-playwright-base:${BASE_TAG}

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts \
 && npm cache clean --force \
 && chgrp -R 0 /app \
 && chmod -R g+rwX /app

COPY . .

RUN mkdir -p /app/test-results \
 && find /app -path /app/node_modules -prune -o -exec chgrp 0 {} + -exec chmod g+rwX {} + \
 && chgrp 0 /app/node_modules \
 && chmod g+rwX /app/node_modules

ENTRYPOINT ["/app/node_modules/.bin/playwright", "test"]
