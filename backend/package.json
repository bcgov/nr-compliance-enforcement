{
  "name": "nr-compliance-enforcement",
  "version": "3.0.16",
  "description": "BCGov devops quickstart. For reference, testing and new projects.",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:staged": "./node_modules/.bin/lint-staged",
    "make-badges": "istanbul-badges-readme --logo=jest --exitCode=1",
    "make-badges:ci": "npm run make-badges -- --ci",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/nr-compliance-enforcement.git"
  },
  "keywords": [
    "openshift",
    "pipeline",
    "node",
    "node",
    "js",
    "devops"
  ],
  "author": "Derek Roberts",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bcgov/nr-compliance-enforcement/issues"
  },
  "homepage": "https://github.com/bcgov/nr-compliance-enforcement#readme",
  "dependencies": {
    "@automapper/core": "9.0.2",
    "@automapper/nestjs": "9.0.2",
    "@automapper/pojos": "9.0.2",
    "@golevelup/ts-jest": "0.7.0",
    "@nestjs/axios": "4.0.1",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/testing": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "axios": "1.20.0",
    "body-parser": "2.4.0",
    "cache-manager": "7.2.8",
    "cron": "^3.1.7",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "16.6.1",
    "escape-html": "1.0.3",
    "fix-esm": "1.0.1",
    "form-data": "4.0.6",
    "geojson": "0.5.0",
    "https-proxy-agent": "7.0.6",
    "jest-mock": "29.7.0",
    "jwks-rsa": "3.2.2",
    "keyv": "5.6.0",
    "linq-to-typescript": "11.1.0",
    "nats": "2.29.3",
    "nest-winston": "1.10.2",
    "npm-check-updates": "17.1.18",
    "nrs-ce-common-types": "1.0.14",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "path-to-regexp": "8.4.2",
    "pg": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-phone-number-input": "3.4.16",
    "reflect-metadata": "0.2.2",
    "rimraf": "4.4.1",
    "rxjs": "7.8.2",
    "supercluster": "7.1.5",
    "swagger-ui-express": "4.6.3",
    "typeorm": "0.3.31",
    "uuid": "14.0.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.28.6",
    "@faker-js/faker": "10.6.0",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "4.17.25",
    "@types/geojson": "7946.0.16",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "@types/passport-jwt": "3.0.13",
    "@types/supercluster": "7.1.3",
    "@types/supertest": "2.0.16",
    "@types/uuid": "10.0.0",
    "istanbul-badges-readme": "1.9.0",
    "jest": "30.5.2",
    "jest-badges": "0.1.3",
    "jest-fetch-mock": "3.0.3",
    "jest-sonar-reporter": "2.0.0",
    "pg-promise": "11.15.0",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "automock": false,
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest",
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid|@automapper)/)"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/",
      ".module.ts",
      ".entity.ts",
      ".dto.ts"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "jest-badges"
    ],
    "testEnvironment": "node",
    "testResultsProcessor": "jest-sonar-reporter",
    "setupFiles": [
      "../test/setupJest.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "./node_modules/.bin/eslint --cache --fix"
  },
  "overrides": {
    "minimist@<1.2.6": "1.2.6",
    "minimatch": {
      ".": "^10.2.3",
      "brace-expansion": "^5.0.12"
    },
    "test-exclude": {
      "minimatch": "^3.1.2",
      "glob": "^7.2.3"
    },
    "jws": "3.2.3",
    "glob": ">=10.5.0",
    "flatted": "^3.4.2",
    "multer": "^2.1.1",
    "picomatch": "^4.0.4",
    "lodash": "^4.17.21",
    "js-yaml": "^4.1.1",
    "ajv": "^8.17.1",
    "cron": "^3.1.7"
  }
}
